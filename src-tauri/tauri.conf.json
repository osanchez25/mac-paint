{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paint",
  "version": "0.1.0",
  "identifier": "dev.oscarsanchez.paint",
  "build": {
    "beforeDevCommand": "npm run build:helper && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:helper && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Untitled - Paint",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.graphics-design",
    "shortDescription": "Paint",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "bmp",
          "gif",
          "tif",
          "tiff",
          "heic",
          "webp",
          "ico"
        ],
        "contentTypes": [
          "public.image"
        ],
        "name": "Image",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "externalBin": [
      "binaries/remove-bg"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
